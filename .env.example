# Environment Configuration
ENV=development

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# CORS Configuration (JSON array of allowed origins; wildcard '*' forbidden in production)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Search Configuration
TAVILY_API_KEY=
SEARCH_PROVIDER=tavily
SEARCH_TIMEOUT_SECONDS=10.0
SEARCH_MAX_RESULTS=5

# Extraction Configuration
EXTRACTION_TIMEOUT_SECONDS=10.0
EXTRACTION_MAX_CHARS=50000

# LLM Configuration
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_CHARS_PER_DOC=4000

# Embedding Configuration (Supabase Edge Function via Supabase.ai gte-small)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_EMBEDDING_FUNCTION_URL=https://[YOUR-PROJECT-REF].supabase.co/functions/v1/embed
EMBEDDING_DIMENSIONS=384
EMBEDDING_TIMEOUT_SECONDS=30.0
EMBEDDING_MAX_CONCURRENCY=3

# Chunking & Candidate Pre-Filtering Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CANDIDATE_CHUNKS_PRE_EMBED=60
CANDIDATE_CHUNKS_MAX_PER_DOC=6

# Planner Configuration
PLANNER_MAX_SUB_QUESTIONS=5
PLANNER_TIMEOUT_SECONDS=30.0

# Retrieval Configuration
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=
RETRIEVAL_MAX_TOTAL_CHUNKS=15
RETRIEVAL_CONCURRENCY=2

# Claim & Verification Configuration
CLAIM_MAX_COUNT=15
CLAIM_EXTRACTION_TIMEOUT_SECONDS=30.0
CLAIM_VERIFICATION_TIMEOUT_SECONDS=30.0
CLAIM_VERIFICATION_CONCURRENCY=5
CLAIM_VERIFICATION_BATCHED=true

# Database Configuration (Supabase PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=300
DATABASE_TIMEOUT_SECONDS=10.0

# Rate Limiting Configuration (In-memory per-worker abuse protection)
# Set RATE_LIMIT_ENABLED=true in production deployments
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60
